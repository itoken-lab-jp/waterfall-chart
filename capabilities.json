{
    "dataRoles": [
        {
            "displayName": "カテゴリ",
            "description": "項目。事業 > 製品 > 科目 > 明細 のように上から順に入れる。複数入れるとドリルダウンできる",
            "name": "hierarchy",
            "kind": "Grouping"
        },
        {
            "displayName": "値",
            "description": "1 つなら項目の値を積む。2 つ以上なら、入れた順に比べるもの（計画・実績など）とみなして差を並べる",
            "name": "value",
            "kind": "Measure"
        },
        {
            "displayName": "比較",
            "description": "比べるものの名前の列（計画・実績、前年・今年、期首・期末、店舗 A・B、施策の前後など）。値は 1 つにする。左端と右端は、既定で並びの最初と最後",
            "name": "event",
            "kind": "Grouping"
        },
        {
            "displayName": "起点",
            "description": "期首の残高など。起点から項目の値を積み、最後の合計を起点 + 増減で出す",
            "name": "origin",
            "kind": "Measure"
        },
        {
            "displayName": "小計",
            "description": "行ごとに、その行を締める小計の名前を持つ列（売上高と売上原価の行は「売上総利益」など）。空の行は小計に入れない",
            "name": "subtotal",
            "kind": "Grouping"
        },
        {
            "displayName": "凡例",
            "description": "1 本の増減を、凡例の値ごとの色で積む",
            "name": "series",
            "kind": "Grouping"
        },
        {
            "displayName": "目標",
            "description": "目標の値に線を引く",
            "name": "target",
            "kind": "Measure"
        },
        {
            "displayName": "ツールヒント",
            "description": "ツールヒントに足す値",
            "name": "tooltips",
            "kind": "Measure"
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "hierarchy": {
                        "max": 10
                    },
                    "value": {
                        "max": 10
                    },
                    "event": {
                        "max": 1
                    },
                    "origin": {
                        "max": 1
                    },
                    "subtotal": {
                        "max": 1
                    },
                    "series": {
                        "max": 1
                    },
                    "target": {
                        "max": 1
                    },
                    "tooltips": {
                        "max": 10
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "select": [
                        {
                            "for": {
                                "in": "hierarchy"
                            }
                        },
                        {
                            "for": {
                                "in": "subtotal"
                            }
                        },
                        {
                            "for": {
                                "in": "event"
                            }
                        }
                    ],
                    "dataReductionAlgorithm": {
                        "window": {
                            "count": 30000
                        }
                    }
                },
                "values": {
                    "group": {
                        "by": "series",
                        "select": [
                            {
                                "for": {
                                    "in": "value"
                                }
                            },
                            {
                                "for": {
                                    "in": "origin"
                                }
                            },
                            {
                                "for": {
                                    "in": "target"
                                }
                            },
                            {
                                "for": {
                                    "in": "tooltips"
                                }
                            }
                        ],
                        "dataReductionAlgorithm": {
                            "top": {
                                "count": 60
                            }
                        }
                    }
                }
            }
        }
    ],
